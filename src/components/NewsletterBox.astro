---
import { SITE } from '../config';
import { getNewsletterIssues } from '../lib/substack';

const { issues, isPlaceholder } = await getNewsletterIssues(5);
const subscribeUrl = `${SITE.substackUrl}/subscribe`;
---

<section id="newsletter" class="section-plain" aria-labelledby="newsletter-heading">
  <div class="section-header">
    <h2 id="newsletter-heading" class="section-title">newsletter</h2>
  </div>

  <div class="ascii-box">
    <p class="box-intro">
      Escrevo periodicamente no <strong>Substack</strong> sobre código,
      produtos simples e coisas que estou testando. Sem spam.
    </p>

    <form
      id="newsletter-form"
      class="subscribe-form"
      action={subscribeUrl}
      method="GET"
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="field">
        <label for="newsletter-email">Seu e-mail</label>
        <span id="email-hint" class="hint">Formato: voce@exemplo.com</span>
        <div class="input-row">
          <div class="input-wrap">
            <input
              type="email"
              id="newsletter-email"
              name="email"
              required
              autocomplete="email"
              autocorrect="off"
              autocapitalize="none"
              spellcheck="false"
              enterkeyhint="done"
              placeholder="voce@exemplo.com"
              aria-describedby="email-hint"
              data-error="email-error"
              aria-invalid="false"
            />
            <div id="email-error" class="error-msg">
              <span role="img" aria-label="Erro">!</span> Digite um e-mail válido no formato voce@exemplo.com.
            </div>
          </div>
          <button type="submit" class="submit-btn">[ assinar ]</button>
        </div>
      </div>
    </form>
  </div>

  <div id="edicoes" class="issues">
    <h3 class="issues-heading">
      últimas edições
      {isPlaceholder && <span class="badge">(exemplo)</span>}
    </h3>

    <ul class="issues-list">
      {
        issues.map((issue) => (
          <li class="issue-item">
            <time datetime={issue.date} class="issue-date">
              {issue.date}
            </time>
            <a
              href={issue.url}
              target="_blank"
              rel="noopener noreferrer"
              class="issue-link"
            >
              {issue.title}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="all-issues">
      <a href={SITE.substackUrl} target="_blank" rel="noopener noreferrer">
        ver arquivo completo no Substack -&gt;
      </a>
    </p>
  </div>
</section>

<style>
  .ascii-box {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-block-start: 3px solid var(--accent);
    border-radius: var(--radius-md);
    corner-shape: squircle;
    box-shadow:
      0 2px 6px var(--shadow-soft),
      0 12px 28px -12px var(--shadow-elevated);
    padding: 1.3rem;
    margin-block-end: 1.5rem;
  }

  @media (forced-colors: active) {
    .ascii-box {
      box-shadow: none;
    }
  }

  .box-intro {
    margin-block-end: 1.15rem;
    color: var(--ink-secondary);
    font-size: 0.94rem;
  }

  .box-intro strong {
    color: var(--ink-primary);
  }

  .field {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  label {
    display: inline-block;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink-primary);
    padding: 6px 0;
    margin: -6px 0 0.2rem;
  }

  .hint {
    display: block;
    color: var(--ink-muted);
    font-size: 0.8rem;
    margin-block-end: 0.55rem;
  }

  .input-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: flex-start;
  }

  .input-wrap {
    flex: 1 1 13rem;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
  }

  input[type='email'] {
    font: inherit;
    font-size: max(1rem, 1em);
    inline-size: 100%;
    min-block-size: 48px;
    padding: 0.65rem 0.8rem;
    color: var(--ink-primary);
    background: var(--bg-elevated);
    border: 1px solid var(--border-ink);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  input[type='email']::placeholder {
    color: var(--ink-muted);
    opacity: 0.8;
  }

  input[type='email']:focus {
    border-color: var(--accent);
  }

  input[type='email']:is(:user-invalid, .user-invalid-fallback) {
    border-color: var(--error);
    background-color: var(--error-bg);
  }

  input[type='email']:user-valid {
    border-color: var(--success);
  }

  .error-msg {
    display: none;
    opacity: 0;
    color: var(--error);
    font-size: 0.85rem;
    margin-block-start: 0.4rem;
    transition: display, opacity 0.22s ease-out;
    transition-behavior: allow-discrete;
  }

  input[type='email']:is(:user-invalid, .user-invalid-fallback) + .error-msg {
    display: block;
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .error-msg {
      translate: 0 -4px;
      transition:
        display,
        opacity 0.25s ease-out,
        translate 0.3s var(--ease-settle);
      transition-behavior: allow-discrete;
    }

    input[type='email']:is(:user-invalid, .user-invalid-fallback) + .error-msg {
      translate: 0 0;
    }

    @starting-style {
      input[type='email']:is(:user-invalid, .user-invalid-fallback) + .error-msg {
        opacity: 0;
        translate: 0 -6px;
      }
    }
  }

  .submit-btn {
    font: inherit;
    font-size: max(1rem, 1em);
    font-weight: 600;
    min-block-size: 48px;
    padding: 0.65rem 1.15rem;
    color: var(--bg-paper);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .submit-btn:hover {
    color: var(--bg-paper);
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .submit-btn {
      transition:
        background-color 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        translate 0.35s var(--ease-spring),
        scale 0.3s var(--ease-spring);
    }

    .submit-btn:hover {
      translate: 0 -2px;
    }

    .submit-btn:active {
      scale: 0.96;
      translate: 0 0;
    }
  }

  @media (pointer: coarse) {
    input[type='email'],
    .submit-btn {
      min-block-size: 52px;
    }
  }

  @media (max-width: 480px) {
    .submit-btn {
      inline-size: 100%;
    }
  }

  .issues {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    corner-shape: squircle;
    padding: 1.15rem 1.25rem;
  }

  .issues-heading {
    font-size: 0.88rem;
    color: var(--ink-primary);
    font-weight: 600;
    margin-block-end: 0.75rem;
  }

  .issues-heading::before {
    content: '// ';
    color: var(--accent-cool);
  }

  .badge {
    font-weight: 400;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }

  .issues-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.1rem;
    display: flex;
    flex-direction: column;
  }

  .issue-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 0.9rem;
    align-items: baseline;
    padding-block: 0.5rem;
  }

  .issue-item:not(:last-child) {
    border-block-end: 1px dotted var(--border-ink);
  }

  @media (max-width: 420px) {
    .issue-item {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
  }

  .issue-date {
    color: var(--ink-muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .issue-link {
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .all-issues {
    margin: 0;
    padding-block-start: 0.65rem;
    border-block-start: 1px solid var(--border-subtle);
    font-size: 0.86rem;
  }
</style>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const emailInput = document.getElementById('newsletter-email') as HTMLInputElement | null;

  if (form && emailInput) {
    const linkError = (el: HTMLInputElement, shown: boolean) => {
      const errorId = el.dataset.error;
      if (!errorId) return;
      const ids = (el.getAttribute('aria-describedby') || '')
        .split(/\s+/)
        .filter((id) => id && id !== errorId);
      if (shown) ids.push(errorId);
      if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
      else el.removeAttribute('aria-describedby');
    };

    const announcer = document.createElement('div');
    announcer.setAttribute('aria-live', 'polite');
    announcer.classList.add('visually-hidden');
    document.body.append(announcer);
    let announceTimer: number | undefined;

    const spokenText = (node: HTMLElement) => {
      const copy = node.cloneNode(true) as HTMLElement;
      copy.querySelectorAll('[aria-hidden="true"]').forEach((n) => n.remove());
      copy
        .querySelectorAll('[role="img"][aria-label]')
        .forEach((n) => n.replaceWith(`${n.getAttribute('aria-label')}: `));
      return (copy.textContent || '').replace(/\s+/g, ' ').trim();
    };

    const announceError = (el: HTMLInputElement) => {
      const errorId = el.dataset.error;
      if (!errorId) return;
      const error = document.getElementById(errorId);
      if (!error) return;
      const label = el.labels?.[0] ? `${spokenText(el.labels[0])}: ` : '';
      window.clearTimeout(announceTimer);
      announcer.textContent = '';
      announceTimer = window.setTimeout(() => {
        announcer.textContent = label + spokenText(error);
      }, 500);
    };

    const supportsUserInvalid = CSS.supports('selector(:user-invalid)');
    let hasInteracted = false;
    let hasBlurred = false;
    let announcedCurrentError = false;

    const syncAria = (announce = false) => {
      const invalid = supportsUserInvalid
        ? emailInput.matches(':user-invalid')
        : (hasBlurred || emailInput.classList.contains('user-invalid-fallback')) &&
          !emailInput.validity.valid;

      if (!supportsUserInvalid && (hasBlurred || hasInteracted)) {
        emailInput.classList.toggle('user-invalid-fallback', !emailInput.validity.valid);
      }

      if (invalid) {
        if (announce && !announcedCurrentError) {
          announceError(emailInput);
          announcedCurrentError = true;
        }
        emailInput.setAttribute('aria-invalid', 'true');
        linkError(emailInput, true);
      } else {
        emailInput.setAttribute('aria-invalid', 'false');
        linkError(emailInput, false);
        announcedCurrentError = false;
        window.clearTimeout(announceTimer);
        announcer.textContent = '';
      }
    };

    emailInput.addEventListener('blur', () => {
      hasBlurred = true;
      if (hasInteracted) syncAria(true);
    });

    emailInput.addEventListener('input', () => {
      hasInteracted = true;
      if (emailInput.hasAttribute('aria-invalid')) syncAria(false);
    });

    emailInput.addEventListener('invalid', () => {
      hasInteracted = true;
      hasBlurred = true;
      announcedCurrentError = true;
      if (!supportsUserInvalid) {
        emailInput.classList.add('user-invalid-fallback');
      }
      syncAria(false);
    });

    form.addEventListener('reset', () => {
      hasInteracted = false;
      hasBlurred = false;
      announcedCurrentError = false;
      emailInput.classList.remove('user-invalid-fallback');
      window.setTimeout(() => syncAria(false));
    });
  }
</script>

