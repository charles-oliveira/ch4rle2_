---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AsciiHero from '../../components/AsciiHero.astro';
import FivePicks from '../../components/FivePicks.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../config';

const allDicas = (await getCollection('dicas')).sort(
  (a, b) => b.data.data.getTime() - a.data.data.getTime()
);
---

<BaseLayout
  title={`5 de sexta — ${SITE.name}`}
  description="Arquivo semanal com 5 dicas de livros, filmes, artigos e ferramentas publicadas toda sexta-feira."
>
  <AsciiHero activePage="dicas" />

  <section class="section" aria-labelledby="archive-heading">
    <div class="section-header">
      <h2 id="archive-heading" class="section-title">
        arquivo · 5 de sexta
      </h2>
      <span class="muted">{allDicas.length} edições</span>
    </div>

    <p class="archive-intro muted">
      Toda sexta-feira, cinco coisas que valeram a atenção na semana: livros,
      filmes, textos, discos e ferramentas.
    </p>

    <div class="archive-list">
      {allDicas.map((entry) => <FivePicks entry={entry} />)}
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .archive-intro {
    margin-block-end: 2rem;
  }

  .archive-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
</style>
