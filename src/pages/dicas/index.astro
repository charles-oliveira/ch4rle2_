---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AsciiHero from '../../components/AsciiHero.astro';
import FivePicks from '../../components/FivePicks.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../config';

const allDicas = (await getCollection('dicas')).sort(
  (a, b) => b.data.data.getTime() - a.data.data.getTime()
);
---

<BaseLayout
  title={`5 de sexta — ${SITE.name}`}
  description="Arquivo semanal com 5 dicas de livros, filmes, artigos e ferramentas publicadas toda sexta-feira."
>
  <AsciiHero activePage="dicas" />

  <section class="section" aria-labelledby="archive-heading">
    <div class="section-header">
      <h2 id="archive-heading" class="section-title">
        arquivo · 5 de sexta
      </h2>
      <span class="archive-count">{allDicas.length} edições</span>
    </div>

    <p class="archive-intro">
      Toda sexta-feira, cinco coisas que valeram a atenção na semana: livros,
      filmes, textos, discos e ferramentas.
    </p>

    <nav class="edition-index" aria-label="Índice de edições">
      <span class="index-label">ir para edição:</span>
      <ul class="index-list">
        {
          allDicas.map((entry) => {
            const num = String(entry.data.edicao).padStart(2, '0');
            const date = entry.data.data.toISOString().slice(0, 10);
            return (
              <li>
                <a href={`#edicao-${entry.data.edicao}`} class="index-link">
                  <span class="index-num">#{num}</span>
                  <span class="index-date">{date}</span>
                  {entry.data.titulo && (
                    <span class="index-title">— {entry.data.titulo}</span>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="archive-list">
      {allDicas.map((entry) => <FivePicks entry={entry} />)}
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .archive-count {
    font-size: 0.85rem;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .archive-intro {
    margin-block-end: 1.5rem;
    color: var(--ink-secondary);
  }

  .edition-index {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--radius-md);
    corner-shape: squircle;
    padding: 0.95rem 1.15rem;
    margin-block-end: 2.25rem;
  }

  .index-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-muted);
    margin-block-end: 0.5rem;
  }

  .index-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .index-link {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.55rem;
    text-decoration: none;
    padding-block: 0.2rem;
    font-size: 0.88rem;
  }

  .index-num {
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .index-date {
    color: var(--ink-muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }

  .index-title {
    color: var(--ink-primary);
  }

  .index-link:hover .index-title {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .index-list > li {
      --stagger-time: 55ms;
      animation: rise-in 0.45s var(--ease-settle) both;
    }

    @supports (animation-delay: calc(sibling-index() * 0.1s)) {
      .index-list > li {
        animation-delay: calc((sibling-index() - 1) * var(--stagger-time));
      }
    }

    @supports not (animation-delay: calc(sibling-index() * 0.1s)) {
      .index-list > li:nth-child(1) { animation-delay: 0ms; }
      .index-list > li:nth-child(2) { animation-delay: 55ms; }
      .index-list > li:nth-child(3) { animation-delay: 110ms; }
      .index-list > li:nth-child(4) { animation-delay: 165ms; }
      .index-list > li:nth-child(5) { animation-delay: 220ms; }
    }

    .index-link {
      transition: translate 0.3s var(--ease-spring);
    }

    .index-link:hover {
      translate: 4px 0;
    }
  }

  .archive-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-inline-size: 46rem;
  }
</style>
